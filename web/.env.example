# ? LIMINA
# Server-only. Never prefix this with NEXT_PUBLIC_.
LIMINA_API_KEY=

# Limina Community is the default. Override only for a Professional account.
LIMINA_API_BASE_URL=https://api.getlimina.ai/community/v4

# ? PRESIDIO
# Local Docker Compose defaults. Vercel Services injects these bindings in production.
PRESIDIO_ANALYZER_URL=http://127.0.0.1:5002
PRESIDIO_ANONYMIZER_URL=http://127.0.0.1:5001


# ? Ancillary
NEXT_PUBLIC_ENVIRONMENT_LABEL=development
NEXT_PUBLIC_PROXY_URL=https://lumina-demo-proxy.reimaginenetwork.workers.dev
