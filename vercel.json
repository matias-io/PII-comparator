{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "services": {
    "web": {
      "root": "web/",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "presidio",
          "format": "url",
          "env": "PRESIDIO_ANALYZER_URL"
        },
        {
          "type": "service",
          "service": "presidio",
          "format": "url",
          "env": "PRESIDIO_ANONYMIZER_URL"
        }
      ]
    },
    "presidio": {
      "root": "services/presidio-vercel/",
      "framework": "fastapi",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
