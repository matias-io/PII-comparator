{
  "name": "pii-redaction-compare",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "concurrently -k -n web,presidio -c blue,green \"npm run dev:web\" \"npm run dev:presidio\"",
    "dev:web": "npm --workspace web run dev",
    "dev:presidio": "docker compose -f docker-compose.dev.yml up",
    "dev:presidio:down": "docker compose -f docker-compose.dev.yml down",
    "build": "npm --workspace web run build",
    "lint": "npm --workspace web run lint",
    "typecheck": "npm --workspace web run typecheck",
    "check": "npm run lint && npm run typecheck && npm run build"
  },
  "devDependencies": {
    "concurrently": "10.0.5"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
